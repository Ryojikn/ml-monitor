# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# SQLite — zero-config, good for local development:
DATABASE_URL=sqlite+aiosqlite:///./mlmonitor.db

# PostgreSQL (local or self-hosted):
# DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/mlmonitor

# Supabase — direct connection (development / low-traffic):
# DATABASE_URL=postgresql+asyncpg://postgres:[password]@db.[project-ref].supabase.co:5432/postgres

# Supabase — connection pooler (recommended for production / serverless):
# DATABASE_URL=postgresql+asyncpg://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------

UPLOAD_DIR=./uploads
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
FRONTEND_BASE_URL=http://localhost:3000
